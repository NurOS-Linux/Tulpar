#: src/main.c:24
#, c-format
msgid ""
"usage: tulpar <command> [options] [args]\n"
"\n"
msgstr ""
"использование: tulpar <команда> [опции] [аргументы]\n"
"\n"

#: src/main.c:25
#, c-format
msgid "commands:\n"
msgstr "команды:\n"

#: src/main.c:44
#, c-format
msgid ""
"\n"
"global flags:\n"
msgstr ""
"\n"
"глобальные флаги:\n"

#: src/main.c:45
#, c-format
msgid "  -h, --help              show this help text\n"
msgstr "  -h, --help              показать эту справку\n"

#: src/main.c:46
#, c-format
msgid "  -V, --version           show the tulpar version\n"
msgstr "  -V, --version           показать версию tulpar\n"

#: src/main.c:47
#, c-format
msgid "  -y, --yes               assume yes on confirmation prompts\n"
msgstr "  -y, --yes               автоматически подтверждать запросы\n"

#: src/main.c:48
#, c-format
msgid "  -j, --json              machine-readable output\n"
msgstr "  -j, --json              вывод в машиночитаемом формате\n"

#: src/main.c:49
#, c-format
msgid "  -d, --dest <path>       operate against an alternate root\n"
msgstr "  -d, --dest <path>       работать с альтернативным корнем\n"

#: src/main.c:50
#, c-format
msgid "  -q, --quiet             suppress informational output\n"
msgstr "  -q, --quiet             подавить информационный вывод\n"

#: src/main.c:51
#, c-format
msgid "      --verbose           enable debug output\n"
msgstr "      --verbose           включить отладочный вывод\n"

#: src/main.c:52
#, c-format
msgid "      --offline           never touch the network, use cached indexes\n"
msgstr ""
"      --offline           не обращаться к сети, использовать кэш индексов\n"

#: src/main.c:54
#, c-format
msgid "      --color <when>      colorize output: auto, always, never\n"
msgstr "      --color <когда>     цветной вывод: auto, always, never\n"

