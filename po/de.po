#: src/main.c:24
#, c-format
msgid ""
"usage: tulpar <command> [options] [args]\n"
"\n"
msgstr ""
"Verwendung: tulpar <Befehl> [Optionen] [Argumente]\n"
"\n"

#: src/main.c:25
#, c-format
msgid "commands:\n"
msgstr "Befehle:\n"

#: src/main.c:45
msgid "show the usage of tulpar or of one command"
msgstr "zeigt die Hilfe zu tulpar oder zu einem Befehl"

