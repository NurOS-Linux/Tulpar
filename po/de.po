#, c-format
msgid ""
"\n"
"global flags:\n"
msgstr ""
"\n"
"Globale Optionen:\n"

#: src/main.c:48
#, c-format
msgid "  -h, --help              show this help text\n"
msgstr "  -h, --help              diese Hilfe anzeigen\n"

#: src/main.c:49
#, c-format
msgid "  -V, --version           show the tulpar version\n"
msgstr "  -V, --version           die tulpar-Version anzeigen\n"

