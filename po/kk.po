#: src/main.c:24
#, c-format
msgid ""
"usage: tulpar <command> [options] [args]\n"
"\n"
msgstr ""
"қолданылуы: tulpar <команда> [опциялар] [аргументтер]\n"
"\n"

#: src/main.c:25
#, c-format
msgid "commands:\n"
msgstr "командалар:\n"

#: src/main.c:45
msgid "show the usage of tulpar or of one command"
msgstr "tulpar немесе бір команда бойынша анықтаманы көрсету"

#: src/main.c:47
#, c-format
msgid ""
"\n"
"global flags:\n"
msgstr ""
"\n"
"жаһандық жалаушалар:\n"

#: src/main.c:48
#, c-format
msgid "  -h, --help              show this help text\n"
msgstr "  -h, --help              осы анықтаманы көрсету\n"

#: src/main.c:49
#, c-format
msgid "  -V, --version           show the tulpar version\n"
msgstr "  -V, --version           tulpar нұсқасын көрсету\n"

#: src/main.c:50
#, c-format
msgid "  -y, --yes               assume yes on confirmation prompts\n"
msgstr "  -y, --yes               сұрауларды автоматты түрде растау\n"

#: src/main.c:51
#, c-format
msgid "  -j, --json              machine-readable output\n"
msgstr "  -j, --json              машина оқи алатын форматта шығару\n"

#: src/main.c:52
#, c-format
msgid "  -d, --dest <path>       operate against an alternate root\n"
msgstr "  -d, --dest <path>       басқа түбірде жұмыс істеу\n"

#: src/main.c:53
#, c-format
msgid "  -q, --quiet             suppress informational output\n"
msgstr "  -q, --quiet             ақпараттық шығаруды басу\n"

#: src/main.c:54
#, c-format
msgid "      --verbose           enable debug output\n"
msgstr "      --verbose           жөндеу шығысын қосу\n"

#: src/main.c:55
#, c-format
msgid "      --offline           never touch the network, use cached indexes\n"
msgstr ""
"      --offline           желіге қосылмау, индекстердің кэшін қолдану\n"

#: src/main.c:57
#, c-format
msgid "      --color <when>      colorize output: auto, always, never\n"
msgstr "      --color <қашан>     түсті шығару: auto, always, never\n"

#: src/main.c:94
#, c-format
msgid "tulpar %s\n"
msgstr "tulpar %s\n"

#: src/main.c:117 src/cmd/cmd_common.c:55
#, c-format
msgid "unknown option: %s"
msgstr "беймәлім опция: %s"

#: src/main.c:120
#, c-format
msgid "unknown command: %s"
msgstr "беймәлім команда: %s"

#: src/main.c:123 src/cmd/cmd_common.c:92
#, c-format
msgid "did you mean '%s'?"
msgstr "'%s' деп айтқыңыз келді ме?"

#: src/main.c:125
msgid "run 'tulpar --help' to see the available commands"
msgstr "командалар тізімі: 'tulpar --help'"

#: src/main.c:151
#, c-format
msgid "invalid value for --color: %s"
msgstr "--color үшін жарамсыз мән: %s"

#: src/main.c:152
msgid "use one of: auto, always, never"
msgstr "рұқсат етілген мәндер: auto, always, never"

#: src/main.c:170
msgid "failed to initialise configuration"
msgstr "баптауды бастау сәтсіз аяқталды"

