msgid "mark a package as automatic or explicit"
msgstr "пакетті автоматты немесе айқын деп белгілеу"

#: src/cli/dispatch.c:55
msgid "reinstall installed packages"
msgstr "орнатылған пакеттерді қайта орнату"

#: src/cli/dispatch.c:56
msgid "show package database statistics"
msgstr "пакеттер дерекқорының статистикасын көрсету"

#: src/cli/dispatch.c:57 src/cli/dispatch.c:59 src/cli/dispatch.c:60
msgid "show past install/remove operations"
msgstr "орнату/өшіру әрекеттерінің тарихын көрсету"

#: src/cli/dispatch.c:61
msgid "manage configured repositories"
msgstr "бапталған репозиторийлерді басқару"

#: src/cli/dispatch.c:62
msgid "fetch a package without installing it"
msgstr "дестені орнатпай жүктеп алу"

#: src/cli/dispatch.c:64
msgid "manage the trusted signing keyring"
msgstr "сенімді қолтаңба кілттер байламын басқару"

#: src/cli/dispatch.c:65
msgid "export the installed package dependency graph as DOT"
msgstr "орнатылған дестелер тәуелділіктер графигін DOT түрінде экспорттау"

#: src/cli/dispatch.c:67 src/cli/dispatch.c:69
msgid "purge downloaded packages and metadata cache"
