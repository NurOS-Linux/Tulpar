msgstr "мыналарға да қажет:"

#: src/cmd/cmd_why.c:132
#, c-format
msgid "%s is not required by any package"
msgstr "%s ешбір пакетке қажет емес"

#: src/cmd/cmd_why.c:133
msgid "it is an orphan and can be removed with 'tulpar orphans'"
msgstr "бұл жетім пакет, оны 'tulpar orphans' арқылы жоюға болады"

#: src/cmd/cmd_why.c:138
#, c-format
msgid "%s was installed as a dependency"
msgstr "%s тәуелділік ретінде орнатылған"

#: src/cmd/cmd_why.c:139
msgid "required by:"
msgstr "мыналарға қажет:"

#: src/cmd/cmd_why.c:145
msgid "chain:"
msgstr "тізбек:"

#: src/cmd/cmd_why.c:151
msgid ""
"only unused packages require it, so it can be removed with 'tulpar orphans'"
msgstr ""
"ол тек пайдаланылмайтын пакеттерге қажет, сондықтан оны 'tulpar orphans' "
"арқылы жоюға болады"

#: src/cmd/resolve.c:204
#, c-format
msgid "%s is not a valid package: %s"
msgstr "%s жарамды десте емес: %s"

#: src/cmd/resolve.c:234
#, c-format
msgid "cannot fetch %s in offline mode"
msgstr "offline режимінде %s алуға болмайды"

#: src/cmd/resolve.c:251
#, c-format
msgid "failed to create a temporary directory for %s"
msgstr "%s үшін уақытша бума жасау сәтсіз аяқталды"

#: src/cmd/resolve.c:285
#, c-format
msgid "failed to clone %s"
msgstr "%s клондау сәтсіз аяқталды"

#: src/cmd/resolve.c:295
#, c-format
msgid "%s does not contain a metadata.json at its root"
msgstr "%s түбірінде metadata.json табылмады"

#: src/cmd/resolve.c:336
#, c-format
msgid "failed to archive the cloned repository at %s"
msgstr "%s орнында клондалған репозиторийді архивтеу сәтсіз аяқталды"

#: src/cmd/resolve.c:344
#, c-format
msgid "%s did not produce a valid package: %s"
msgstr "%s жарамды десте бермеді: %s"

#: src/cmd/resolve.c:432
#, c-format
msgid ""
"'%s' is provided by %d packages; use --provider %s=<package> to pick one"
msgstr ""
"'%s' %d десте арқылы ұсынылған; біреуін таңдау үшін --provider %s=<десте> "
"қолданыңыз"

#: src/cmd/resolve.c:564
#, c-format
msgid "cannot download %s %s from %s: %s"
msgstr "%s %s дестесін %s ішінен жүктеу мүмкін болмады: %s"

#: src/cmd/resolve.c:574
#, c-format
msgid "%s %s from %s is not a valid package: %s"
msgstr "%s ішіндегі %s %s жарамды десте емес: %s"

#: src/cmd/resolve.c:665
#, c-format
msgid "skipping installation of %s (--nodeps)"
msgstr "%s орнату өткізіліп жіберілді (--nodeps)"

#: src/cmd/resolve.c:667
#, c-format
msgid "%s depends on %s and may not work without it"
msgstr "%s %s дестесіне тәуелді және онсыз жұмыс істемеуі мүмкін"

#: src/cmd/resolve.c:714
#, c-format
msgid "%s requires %s, which was not found in any configured repository"
msgstr ""
"%s үшін %s қажет, бірақ ол бапталған репозиторийлердің ешқайсысында табылмады"

#: src/cmd/resolve.c:719 src/cmd/resolve.c:891
msgid "no repositories are configured; add one with 'tulpar repo add <url>'"
msgstr ""
"репозиторийлер бапталмаған; 'tulpar repo add <url>' командасымен қосыңыз"

#: src/cmd/resolve.c:772
#, c-format
msgid "%s %s is already installed"
msgstr "%s %s орнатылып қойған"

#: src/cmd/resolve.c:775
#, c-format
msgid "skipping %s %s: the installed version %s is newer"
msgstr "%s %s өткізіліп жіберілді: орнатылған %s нұсқасы жаңарақ"

#: src/cmd/resolve.c:834 src/cmd/resolve.c:845
#, c-format
msgid "failed to install from %s"
msgstr "%s ішінен орнату сәтсіз аяқталды"

#: src/cmd/resolve.c:856
#, c-format
msgid "failed to read package archive %s: %s"
msgstr "%s десте мұрағатын оқу мүмкін болмады: %s"

#: src/cmd/resolve.c:888
#, c-format
msgid "package %s not found in any configured repo"
msgstr "%s дестесі бірде-бір бапталған репозиторийде табылмады"

#: src/cmd/resolve.c:894
msgid "offline mode: packages cannot be looked up in the repositories"
msgstr "offline режимі: пакеттерді репозиторийлерден іздеуге болмайды"

#: src/cmd/resolve.c:897
msgid "check the name, or find it with 'tulpar search <query>'"
msgstr "атауды тексеріңіз немесе пакетті 'tulpar search <сұраныс>' арқылы табыңыз"

#: src/cmd/resolve.c:994
#, c-format
msgid "dependency conflict: %s"
msgstr "тәуелділіктер қақтығысы: %s"

#: src/cmd/resolve.c:999
msgid "dependency conflict detected"
msgstr "тәуелділіктер қақтығысы табылды"

#: src/util/paths.c:144
msgid "operation requires root privileges (try with sudo)"
msgstr "әрекетке root құқықтары қажет (sudo көріңіз)"

